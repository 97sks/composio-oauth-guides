# Copy this file to .env.local and fill it in. .env.local is git-ignored; never commit real keys.

# Required for live guide generation (the pipeline calls the Anthropic API).
ANTHROPIC_API_KEY=

# Optional. With it, each live guide checks whether Composio already ships a managed OAuth app for the provider
# (GET /api/v3.1/toolkits/{slug}). Without it that step is labelled "not tested".
COMPOSIO_API_KEY=

# Pipeline settings (defaults shown; see lib/pipeline/config.ts).
PIPELINE_MODEL=claude-sonnet-5-5
GUIDE_MAX_COST_USD=0.60
GUIDE_MAX_REPAIR_TRIES=2

# Public endpoint protection for POST /api/generate.
GENERATE_ENABLED=true
GENERATE_RATE_LIMIT_PER_DAY=3
